{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (Ninja + ccache, Debug)",
      "description": "Fast iteration build. Configure once, then `cmake --build build`.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja + ccache)",
      "description": "Optimized build for performance gates and benchmarks.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Sanitize (ASan + UBSan)",
      "description": "AddressSanitizer + UndefinedBehaviorSanitizer build.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "SSG_SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "sanitize", "configurePreset": "sanitize" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "displayName": "Fast unit tests (excludes browser/perf/recovery)",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 20 },
      "filter": {
        "exclude": {
          "name": "browser_|performance_|test_recovery|test_theme"
        }
      }
    },
    {
      "name": "all",
      "displayName": "Full test suite",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 20 }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 20 }
    }
  ]
}
