#!/usr/bin/env bash
# Pre-push gate: runs EVERY test, including the slow checks the fast gate skips
# (timing benchmarks, the benchmark-corpus correctness oracle, and the
# add_subdirectory consumer build).
#
# Install:
#   ln -s ../../scripts/pre-push.hook .git/hooks/pre-push
#
# Bypass for a work-in-progress branch:
#   git push --no-verify
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
echo "pre-push: running the full gate (bypass with --no-verify)"
if ! bash "$ROOT/scripts/check.sh" push; then
    echo "pre-push: FAILED — push aborted"
    exit 1
fi
echo "pre-push: OK"
